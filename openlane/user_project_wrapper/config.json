{
    "//": "================================================================",
    "// BASE v2.0 – OpenLane config.json",
    "// Changes from v1.0:",
    "//   - VERILOG_FILES updated to explicit v2.0 hierarchy (leaf-first)",
    "//   - caravel_secure_boot macro removed (no longer in hierarchy)",
    "//   - secure_boot_control_plane synthesized as standard cells (flattened)",
    "//   - PDN_MACRO_CONNECTIONS updated to remove u_secure_boot reference",
    "//   - LVS_FLATTEN_CELLS updated",
    "//   - EXTRA_SPICE_MODELS removed (no hardened macro spice yet)",
    "//   - All fixed Caravel floor plan settings preserved unchanged",
    "// NOTE: Once secure_boot_control_plane is hardened as a macro,",
    "//   re-add a MACROS entry and restore EXTRA_SPICE_MODELS.",
    "// ================================================================",

    "DESIGN_NAME": "user_project_wrapper",

    "VERILOG_FILES": [
        "dir::../../verilog/rtl/defines.v",
        "dir::../../verilog/rtl/user_defines.v",
        "dir::../../verilog/rtl/secure_boot_core/secure_boot_fsm.sv",
        "dir::../../verilog/rtl/secure_boot_core/group_fsm.sv",
        "dir::../../verilog/rtl/secure_boot_core/secure_boot_system_wrapper.sv",
        "dir::../../verilog/rtl/control_plane/secure_boot_control_plane.sv",
        "dir::../../verilog/rtl/user_project_wrapper.v"
    ],

    "//": "Fixed Caravel floorplan – DO NOT CHANGE",
    "FP_SIZING": "absolute",
    "DIE_AREA": [0, 0, 2920, 3520],
    "FP_DEF_TEMPLATE": "dir::fixed_dont_change/user_project_wrapper.def",

    "//": "Clock",
    "CLOCK_PORT": "wb_clk_i",
    "CLOCK_PERIOD": 25,
    "PNR_SDC_FILE": "dir::signoff.sdc",
    "SIGNOFF_SDC_FILE": "dir::signoff.sdc",

    "//": "Power nets",
    "VDD_NETS": ["vccd1", "vccd2", "vdda1", "vdda2"],
    "GND_NETS": ["vssd1", "vssd2", "vssa1", "vssa2"],

    "//": "PDN – all values preserved from v1.0",
    "FP_PDN_ENABLE_RAILS": true,
    "FP_PDN_CORE_RING": true,
    "FP_PDN_VOFFSET": 5,
    "FP_PDN_HOFFSET": 5,
    "FP_PDN_VWIDTH": 3.1,
    "FP_PDN_HWIDTH": 3.1,
    "FP_PDN_VSPACING": 15.5,
    "FP_PDN_HSPACING": 15.5,
    "FP_PDN_VPITCH": 180,
    "FP_PDN_HPITCH": 180,
    "FP_PDN_CORE_RING_VWIDTH": 3.1,
    "FP_PDN_CORE_RING_HWIDTH": 3.1,
    "FP_PDN_CORE_RING_VOFFSET": 12.45,
    "FP_PDN_CORE_RING_HOFFSET": 12.45,
    "FP_PDN_CORE_RING_VSPACING": 1.7,
    "FP_PDN_CORE_RING_HSPACING": 1.7,
    "ERROR_ON_PDN_VIOLATIONS": false,

    "//": "Flow control – preserved from v1.0",
    "SYNTH_ELABORATE_ONLY": true,
    "RUN_POST_GPL_DESIGN_REPAIR": false,
    "RUN_POST_CTS_RESIZER_TIMING": false,
    "DESIGN_REPAIR_BUFFER_INPUT_PORTS": false,
    "RUN_ANTENNA_REPAIR": false,
    "RUN_FILL_INSERTION": false,
    "RUN_TAP_ENDCAP_INSERTION": true,
    "RUN_CTS": false,
    "RUN_IRDROP_REPORT": false,
    "ERROR_ON_SYNTH_CHECKS": false,
    "ERROR_ON_NL_ASSIGN_STATEMENTS": false,

    "//": "LVS / Magic",
    "MAGIC_DRC_USE_GDS": true,
    "MAGIC_DEF_LABELS": false,
    "MAGIC_ZEROIZE_ORIGIN": false,
    "MAGIC_EXT_USE_GDS": false,
    "LVS_INCLUDE_MARCO_NETLISTS": true,
    "LVS_FLATTEN_CELLS": ["secure_boot_control_plane"],

    "//": "Timing",
    "MAX_TRANSITION_CONSTRAINT": 1.5,
    "DRT_THREADS": 1,

    "meta": {"version": 2}
}
