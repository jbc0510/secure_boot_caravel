# ============================================================
# BASE v2.0 – RTL includes
# Updated from v1.0: explicit file list replaces implicit chaining.
# Order matters – instantiated modules must appear before their parents.
# ============================================================

# ── Shared defines ───────────────────────────────────────────
-v $(USER_PROJECT_VERILOG)/rtl/defines.v
-v $(USER_PROJECT_VERILOG)/rtl/user_defines.v

# ── Secure boot core (UNCHANGED from v1.0) ───────────────────
# Listed leaf-first so every module is defined before it is instantiated
-v $(USER_PROJECT_VERILOG)/rtl/secure_boot_core/secure_boot_fsm.sv
-v $(USER_PROJECT_VERILOG)/rtl/secure_boot_core/group_fsm.sv
-v $(USER_PROJECT_VERILOG)/rtl/secure_boot_core/secure_boot_system_wrapper.sv

# ── BASE v2.0 control plane (NEW) ────────────────────────────
-v $(USER_PROJECT_VERILOG)/rtl/control_plane/secure_boot_control_plane.sv

# ── Top-level wrapper ─────────────────────────────────────────
-v $(USER_PROJECT_VERILOG)/rtl/user_project_wrapper.v
